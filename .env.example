# Copia este archivo como .env.local y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "true" compila la demo: sin login ni Supabase, datos en el navegador (IndexedDB).
# En el proyecto de Vercel de la demo, esta es la ÚNICA variable que se define.
NEXT_PUBLIC_DEMO_MODE=false
